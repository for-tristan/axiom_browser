# =============================================================================
#  .gitignore for axiom_browser (Flutter app)
#  Apps SHOULD commit pubspec.lock for reproducible builds.
#  (Comment out pubspec.lock line if your team prefers not to.)
# =============================================================================

# --- Dart / Flutter generated ---
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
/build/
/coverage/

# --- IDEs ---
.idea/
*.iml
*.ipr
*.iws
.vscode/
*.swp

# --- macOS / Windows / Linux OS junk ---
.DS_Store
Thumbs.db
desktop.ini

# --- Local environment files (may contain keys) ---
.env
.env.local
*.env.local

# --- Keystore / signing (NEVER commit these) ---
key.properties
**/*.keystore
**/*.jks

# --- Android build artifacts (do commit gradle-wrapper.jar though) ---
android/.gradle/
android/.kotlin/
android/captures/
android/app/build/
android/app/release/
android/build/
android/.cxx/

# Generated by flutter; safe to ignore but harmless if committed
android/app/src/main/java/io/flutter/plugins/GeneratedPluginRegistrant.java

# --- iOS build artifacts ---
ios/Pods/
ios/.symlinks/
ios/Flutter/Flutter.framework
ios/Flutter/Flutter.podspec
ios/Flutter/Generated.xcconfig
ios/Runner/GeneratedPluginRegistrant.h
ios/Runner/GeneratedPluginRegistrant.m

# --- Windows / Linux / macOS desktop build artifacts ---
windows/flutter/ephemeral/
linux/flutter/ephemeral/
macos/Flutter/ephemeral/
macos/Flutter/podfile.lock

# --- Local properties (machine-specific paths) ---
android/local.properties
